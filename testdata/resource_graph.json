  "aws:cloudwatch/metricAlarm:MetricAlarm::vocal-extractor-messages-visible": {
    "Dependencies": [
      "urn:pulumi:test::LyricsPipeline::lyrics:autoscaling:Autoscaling$aws:appautoscaling/policy:Policy::vocal-extractor-scale-out",
      "urn:pulumi:test::LyricsPipeline::lyrics:queue:Queue$aws:sqs/queue:Queue::vocal-extractor-queue",
