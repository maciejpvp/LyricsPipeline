      "alarmDescription": "Scale in only when no SQS messages are visible or in flight",
      "comparisonOperator": "LessThanOrEqualToThreshold",
      "datapointsToAlarm": 5,
      "evaluationPeriods": 5,
      "metricQueries": [
        {
          "id": "visible",
          "metric": {
            "dimensions": {
              "QueueName": "vocal-extractor-queue"
            },
            "metricName": "ApproximateNumberOfMessagesVisible",
            "namespace": "AWS/SQS",
            "period": 60,
            "stat": "Maximum"
          },
          "returnData": false
        },
        {
          "id": "in_flight",
          "metric": {
            "dimensions": {
              "QueueName": "vocal-extractor-queue"
            },
            "metricName": "ApproximateNumberOfMessagesNotVisible",
            "namespace": "AWS/SQS",
            "period": 60,
            "stat": "Maximum"
          },
          "returnData": false
        },
        {
          "expression": "FILL(visible, 1) + FILL(in_flight, 1)",
          "id": "total",
          "label": "Visible and in-flight messages",
          "returnData": true
        }
      ],
      "threshold": 0,
      "treatMissingData": "notBreaching"
    },
    "Name": "vocal-extractor-messages-empty",
