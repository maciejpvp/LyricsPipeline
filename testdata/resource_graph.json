    ],
    "IgnoreChanges": null,
    "Inputs": {
      "alarmActions": [
        "arn:aws:mock::123456789012:vocal-extractor-scale-out"
      ],
      "alarmDescription": "Wake from zero or add one worker when waiting backlog per ready worker reaches the threshold; wait for desired capacity to be running",
      "comparisonOperator": "GreaterThanOrEqualToThreshold",
      "datapointsToAlarm": 1,
      "evaluationPeriods": 1,
      "metricQueries": [
        {
          "id": "visible",
          "metric": {
            "dimensions": {
              "QueueName": "vocal-extractor-queue"
            },
            "metricName": "ApproximateNumberOfMessagesVisible",
            "namespace": "AWS/SQS",
            "period": 60,
            "stat": "Maximum"
          },
          "returnData": false
        },
        {
          "id": "in_flight",
          "metric": {
            "dimensions": {
              "QueueName": "vocal-extractor-queue"
            },
            "metricName": "ApproximateNumberOfMessagesNotVisible",
            "namespace": "AWS/SQS",
            "period": 60,
            "stat": "Maximum"
          },
          "returnData": false
        },
        {
          "id": "desired",
          "metric": {
            "dimensions": {
              "ClusterName": "vocal-extractor-cluster",
              "ServiceName": "vocal-extractor-service"
            },
            "metricName": "DesiredTaskCount",
            "namespace": "ECS/ContainerInsights",
            "period": 60,
            "stat": "Maximum"
          },
          "returnData": false
        },
        {
          "id": "running",
          "metric": {
            "dimensions": {
              "ClusterName": "vocal-extractor-cluster",
              "ServiceName": "vocal-extractor-service"
            },
            "metricName": "RunningTaskCount",
            "namespace": "ECS/ContainerInsights",
            "period": 60,
            "stat": "Minimum"
          },
          "returnData": false
        },
        {
          "id": "pending",
          "metric": {
            "dimensions": {
              "ClusterName": "vocal-extractor-cluster",
              "ServiceName": "vocal-extractor-service"
            },
            "metricName": "PendingTaskCount",
            "namespace": "ECS/ContainerInsights",
            "period": 60,
            "stat": "Maximum"
          },
          "returnData": false
        },
        {
          "expression": "IF((FILL(desired, 0) == 0) AND (FILL(running, 0) == 0) AND (FILL(pending, 0) == 0) AND (FILL(in_flight, 1) == 0), IF(FILL(visible, 0) > 0, 5, 0), IF((FILL(running, 0) > 0) AND (FILL(desired, 0) == FILL(running, 0)) AND (FILL(pending, 1) == 0), FILL(visible, 0) / running, 0))",
          "id": "backlog_per_worker",
          "label": "Waiting messages per ready worker, or wake-up demand",
          "returnData": true
        }
      ],
      "threshold": 5,
      "treatMissingData": "notBreaching"
    },
    "Name": "vocal-extractor-messages-visible",
    "Parent": "urn:pulumi:test::LyricsPipeline::lyrics:autoscaling:Autoscaling::vocal-extractor",
    "Type": "aws:cloudwatch/metricAlarm:MetricAlarm"
  },
