# Development-only defaults. Production must inject the required values securely.
APP_ENV=development
ENABLE_LEGACY_V1=true
MODEL_FILENAME=UVR-MDX-NET-Voc_FT.onnx
MODEL_SHA256=534b2070fcc7df514b13ef660dc8cbb328679c2374d04354a5c42bb14ecce111
MAX_UPLOAD_BYTES=524288000
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1
BUSY_RETRY_AFTER_SECONDS=60
FFPROBE_TIMEOUT_SECONDS=30

# Required in production only. Do not put UPLOAD_TOKEN_SECRET in a committed .env file.
# AWS_REGION=eu-central-1
# MEDIA_BUCKET=private-vocal-extractor-media
# INPUT_PREFIX=vocal-extractor/uploads
# OUTPUT_PREFIX=vocal-extractor/outputs
# STATUS_PREFIX=vocal-extractor/status
# UPLOAD_TOKEN_SECRET=inject-from-secrets-manager
# UPLOAD_URL_TTL_SECONDS=300
# RESULT_URL_TTL_SECONDS=300
